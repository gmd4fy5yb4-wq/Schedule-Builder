NEXT_PUBLIC_SUPABASE_URL=https://actgfxrinoxlyrprzkoh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe — use test keys locally, live keys in Vercel production only
STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret. Local: from `stripe listen` CLI output.
# Production: from Stripe Dashboard → Developers → Webhooks → your endpoint.
STRIPE_WEBHOOK_SECRET=whsec_...
# 6 price IDs: each tier has an annual (recurring) and a season (one-time 3-month) price.
STRIPE_PRICE_STARTER_ANNUAL=price_...
STRIPE_PRICE_STARTER_SEASON=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
STRIPE_PRICE_PRO_SEASON=price_...
STRIPE_PRICE_ORG_ANNUAL=price_...
STRIPE_PRICE_ORG_SEASON=price_...
# Optional: only needed if you add client-side Stripe.js / Elements.
# The current redirect-based Checkout flow does NOT require it.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Resend — used by the app's notify-coaches feature.
# (Magic-link auth is sent separately via Supabase custom SMTP, also Resend.)
# From-domain MUST be a Resend-verified domain. We verify alfred-digital.com
# only (Resend free tier = 1 domain), so do NOT use @fielddayplanner.app here.
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=FieldDay Planner <noreply@alfred-digital.com>

# Sentry — error monitoring
# Get DSN from sentry.io → your project → Settings → Client Keys
NEXT_PUBLIC_SENTRY_DSN=https://your-key@oXXXXXX.ingest.sentry.io/XXXXXXX
# Get auth token from sentry.io → Settings → Auth Tokens (needed for source map upload)
SENTRY_AUTH_TOKEN=sntrys_...
